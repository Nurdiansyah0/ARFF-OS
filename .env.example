# ========================================================
# ARFF-OS Backend (Golang on Railway) Configuration
# ========================================================
PORT=8080
APP_ENV=development

# Supabase PostgreSQL Connection String (Session or Pooler Mode)
DATABASE_URL=postgres://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# ========================================================
# Email SMTP Configuration (Gmail, Brevo, Resend, etc.)
# ========================================================
# Untuk Gmail: gunakan App Password (16 digit) dari Google Security
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM_NAME="ARFF-OS Airport Security"
SMTP_FROM_EMAIL=no-reply@arff-os.com

# ========================================================
# ARFF-OS Frontend (Next.js on Vercel) Configuration
# ========================================================
# URL of your deployed Golang backend on Railway
BACKEND_API_URL=https://arff-os-backend.up.railway.app
NEXT_PUBLIC_APP_NAME="ARFF-OS — Airport Rescue & Firefighting Operating System"
