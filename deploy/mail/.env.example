# ========================================================
# Stalwart Mail Server Environment Configuration
# ========================================================

# Hostname of your mail server (Must point to your server IP in DNS A record)
MAIL_HOSTNAME=mail.yourdomain.com

# Port Mappings
SMTP_INBOUND_PORT=25
SMTP_SUBMISSION_PORT=587
SMTPS_PORT=465
IMAPS_PORT=993
ADMIN_PORT=8443
